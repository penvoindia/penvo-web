{
  "name": "penvo-web",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance web foundation for Penvo.",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check",
    "ci": "npm run check && npm run build && npm run audit:production"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "next": "16.3.8",
    "nitro": "3.0.260903-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
